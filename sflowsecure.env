# sflowsecure configuration environment file. This file is loaded by the
# sflowsecure systemd unit file, but should only be readable by root.

# Both sender and receiver should have the same key.
# Key generator example: openssl rand -hex 32
# SFLOWSECURE_KEY=<insert random 64-character-hex secret key here>

# Example sender config
# SFLOWSECURE_MODE=sender
# SFLOWSECURE_LISTEN=0.0.0.0:6343
# SFLOWSECURE_FORWARD=10.100.100.1:56343

# Example receiver config
# SFLOWSECURE_MODE=receiver
# SFLOWSECURE_LISTEN=0.0.0.0:56343
# SFLOWSECURE_FORWARD=127.0.0.1:6343

